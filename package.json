{
  "name": "-llamacoder",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/build-schema.mjs",
    "build": "tsc && vite build",
    "schema:build": "node scripts/build-schema.mjs",
    "preview": "vite preview",
    "dev:api": "wrangler dev --config wrangler.worker.toml --port 8787",
    "dev:api:local": "wrangler dev --config wrangler.worker.toml --port 8787 --local",
    "worker:dev": "wrangler dev --config wrangler.worker.toml --port 8787",
    "worker:types": "tsc -p worker/tsconfig.json --noEmit",
    "db:local": "wrangler d1 execute portfolio-db --local --file worker/schema.sql",
    "db:remote": "wrangler d1 execute portfolio-db --remote --file worker/schema.sql",
    "deploy": "npm run build && wrangler pages deploy",
    "deploy:worker": "npm run build && wrangler deploy --config wrangler.worker.toml",
    "pages:dev": "wrangler pages dev --port 8788",
    "predeploy": "node scripts/check-cloudflare-config.mjs",
    "deploy:check": "node scripts/check-cloudflare-config.mjs",
    "migrate:cloudflare": "node scripts/migrate-to-cloudflare.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "^8.16.7",
    "clsx": "^2.1.1",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.7.0",
    "three": "^0.168.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261116.1",
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.168.0",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.11",
    "wrangler": "^4.163.0"
  }
}
