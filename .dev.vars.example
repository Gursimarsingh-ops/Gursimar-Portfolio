# Copy to .dev.vars (git-ignored) for local Worker development.
# Generate the hash with: node scripts/hash-admin-password.mjs "<password>"
ADMIN_EMAIL=gursimarsingh9390@gmail.com
ADMIN_PASSWORD_HASH=pbkdf2:100000:replace:me

# AI assistant (server-side only). NVIDIA NIM is OpenAI-compatible, so the
# default endpoint works with the standard chat-completions request shape.
# Leave AI_API_KEY empty to keep the assistant in its "not configured" state;
# store the key from Security Dashboard → AI configuration instead, or use
# `wrangler secret put AI_API_KEY` (Pages: Settings → Variables and Secrets).
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_API_KEY=
AI_MODEL=google/gemma-4-31b-it
AI_PROVIDER=nvidia-nim

# Optional. Only needed when the Vite dev server proxies straight to the
# deployed deployment (API_PROXY_TARGET=https://…). It allowlists that exact
# browser origin for login and other state-changing requests, e.g.
# http://localhost:5173
DEV_ORIGIN=http://localhost:5173

# Private Backblaze B2 bucket (S3-compatible API). Server-side only: these are
# never read by browser code. In production the same names live in
# Pages -> Settings -> Variables and Secrets. Without the two key values the
# site falls back to the R2 binding and multipart uploads stay disabled.
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=gursimar-portfolio
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
