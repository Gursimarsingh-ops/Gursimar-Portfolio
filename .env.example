# ---------------------------------------------------------------------------
# Portfolio environment example — placeholders only, never real credentials.
#
# Local development: copy to .dev.vars (git-ignored) and fill in real values.
# Production (Cloudflare Workers): set these as encrypted secrets:
#   npx wrangler secret put ADMIN_EMAIL
#   npx wrangler secret put ADMIN_PASSWORD_HASH
#   npx wrangler secret put AI_API_KEY
# ---------------------------------------------------------------------------

# Administrator identity used by /security and /admin. Never shipped to the browser.
ADMIN_EMAIL=you@example.com

# PBKDF2 hash of the administrator password — never the plaintext.
# Generate with: node scripts/hash-admin-password.mjs "your-strong-password"
# Format: pbkdf2:<iterations>:<base64 salt>:<base64 hash>  (max 100000 iterations)
ADMIN_PASSWORD_HASH=pbkdf2:100000:<placeholder-salt>:<placeholder-hash>

# ---------------------------------------------------------------------------
# Portfolio Assistant (OpenAI-compatible chat completions endpoint).
# The frontend only calls /api/ai/*; these keys stay in the Worker.
# While AI_API_KEY is empty the assistant reports "backend not configured".
# ---------------------------------------------------------------------------
AI_API_KEY=
AI_API_URL=https://integrate.api.nvidia.com/v1/chat/completions
AI_MODEL=minimax-m3.1-flash
AI_PROVIDER=nvidia-nim

# ---------------------------------------------------------------------------
# Object storage: Backblaze B2 (S3-compatible). Cloudflare R2 is not used.
# The bucket stays private; the Worker streams media through /media/*.
# ---------------------------------------------------------------------------
B2_APPLICATION_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=gursimar-portfolio
B2_REGION=us-east-005
B2_ENDPOINT=https://s3.us-east-005.backblazeb2.com
